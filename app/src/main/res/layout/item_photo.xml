<?xml version="1.0" encoding="utf-8"?>
<!-- Photo cell for the 2-column staggered grid in GalleryActivity.
     Height adapts automatically to image aspect ratio (portrait/landscape). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="1dp">

    <!-- Photo thumbnail fills the square cell -->
    <ImageView
        android:id="@+id/photoImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="@string/photo_desc"
        android:background="?attr/colorSurfaceVariant" />

    <!-- Selection dim overlay: only visible when the item is selected -->
    <View
        android:id="@+id/selectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#660066FF"
        android:visibility="gone" />

    <!-- Selection circle (top-right): hidden unless in select mode -->
    <ImageView
        android:id="@+id/selectionIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Bottom action bar.
         clickable + focusable = TRUE so the touch is consumed HERE
         and does NOT bubble up to photoImage, preventing accidental opens. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#BB000000"
        android:orientation="horizontal"
        android:paddingVertical="2dp"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true">

        <!-- Download button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            app:icon="@drawable/ic_download"
            app:iconSize="16dp"
            app:iconTint="@android:color/white"
            android:contentDescription="@string/download_hint" />

        <!-- Share button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            app:icon="@drawable/ic_share_photo"
            app:iconSize="16dp"
            app:iconTint="@android:color/white"
            android:contentDescription="@string/share_via" />

    </LinearLayout>

</FrameLayout>
