<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- ViewPager2 for swipe navigation between photos -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photoPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar: back arrow only -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#AA000000"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@android:color/white" />

    <!-- Bottom bar: Rotate · Download · Share — compact, centred, equal widths -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotate"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="@dimen/action_button_min_width"
            android:layout_marginEnd="4dp"
            android:text="@string/btn_rotate"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingHorizontal="6dp"
            app:icon="@drawable/ic_rotate"
            app:iconSize="18dp"
            app:iconPadding="4dp"
            app:iconTint="@android:color/white"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="@dimen/action_button_min_width"
            android:layout_marginHorizontal="4dp"
            android:text="@string/btn_download"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingHorizontal="6dp"
            app:icon="@drawable/ic_download"
            app:iconSize="18dp"
            app:iconPadding="4dp"
            app:iconTint="@android:color/white"
            android:textColor="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="@dimen/action_button_min_width"
            android:layout_marginStart="4dp"
            android:text="@string/btn_share"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:paddingHorizontal="6dp"
            app:icon="@drawable/ic_share_photo"
            app:iconSize="18dp"
            app:iconPadding="4dp"
            app:iconTint="@android:color/white"
            android:textColor="@android:color/white" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
